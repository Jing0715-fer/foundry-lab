#!/usr/bin/env bash
# [mock-cluster shim] rosetta_scripts CLI → the REAL built-in score engine.
# Rosetta-style flags (-s <pdb>, -parser:protocol <xml>, -nstruct N,
# -scorefunction …) are routed to
# /home/z/my-project/scripts/algorithms/score_engine.py (MJ contact energy +
# Ramachandran likelihood + Metropolis MC minimization).
set -u
ENGINE="/home/z/my-project/scripts/algorithms/score_engine.py"
HELPER="/home/z/my-project/mini-services/mock-cluster/shims/generic_payload.py"

pdb=""; protocol=""; nstruct=""; scorefn=""; ddG=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s)                    pdb="$2"; shift 2 ;;
    -parser:protocol)      protocol="$2"; shift 2 ;;
    -nstruct)              nstruct="$2"; shift 2 ;;
    -scorefunction)        scorefn="$2"; shift 2 ;;
    -ddG:mut_file|-ddG)    ddG="true"; shift ;;
    *)                     shift ;;  # other Rosetta flags swallowed token-by-token
  esac
done

payload="$(python3 "$HELPER" rosetta "$(pwd)" \
  pdb_path="$pdb" protocol="$protocol" nstruct="$nstruct" \
  scorefunction="$scorefn" ddG="$ddG")" || exit 1

echo "[mock-cluster shim] rosetta_scripts CLI received — routing to the REAL built-in"
echo "[mock-cluster shim] score engine (MJ + Ramachandran + Metropolis MC, numpy):"
echo "[mock-cluster shim] engine: $ENGINE"
echo "[mock-cluster shim] payload: $payload"

exec python3 "$ENGINE" "$payload"
