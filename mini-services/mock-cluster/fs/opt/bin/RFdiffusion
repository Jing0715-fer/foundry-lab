#!/usr/bin/env bash
# [mock-cluster shim] RFdiffusion CLI → the REAL built-in diffusion engine.
#
# This is a TEST-HARNESS routing shim (local test cluster): it accepts the
# hydra-style flag grammar the Foundry Lab app dispatches
#   RFdiffusion inference.num_designs=8 contigmap.contigmap=150 \
#            inference.symmetry=C3 inference.output_prefix=outputs/design
# (aliases tolerated: contigmap.contigs / bare names) and invokes the REAL
# numpy engine at /home/z/my-project/scripts/algorithms/diffusion_engine.py
# with {"params": {...}, "workdir": <dir of output_prefix>}. output_prefix is
# treated as RELATIVE to the current directory when not absolute. Engine
# stdout streams through untouched; the exit code is the engine's own.
set -u

ENGINE="/home/z/my-project/scripts/algorithms/diffusion_engine.py"
HELPER="/home/z/my-project/mini-services/mock-cluster/shims/rfdiffusion_payload.py"

contigmap=""; num_designs=""; total_length=""; symmetry=""
seed=""; partial_T=""; output_prefix=""

for arg in "$@"; do
  key="${arg%%=*}"
  val="${arg#*=}"
  [ "$key" = "$arg" ] && val=""   # boolean flag without '='
  case "$key" in
    contigmap.contigmap|contigmap.contigs|contigmap) contigmap="$val" ;;
    inference.num_designs|num_designs)               num_designs="$val" ;;
    inference.total_length|total_length)             total_length="$val" ;;
    inference.symmetry|symmetry)                     symmetry="$val" ;;
    inference.seed|seed)                             seed="$val" ;;
    diffuser.partial_T|partial_T)                    partial_T="$val" ;;
    inference.output_prefix|output_prefix|output.prefix) output_prefix="$val" ;;
    *) ;;  # ppi.hotspot_res, inference.ckpt_override_path, …: accepted, engine ignores
  esac
done

payload="$(python3 "$HELPER" "$contigmap" "$num_designs" "$total_length" \
  "$symmetry" "$seed" "$partial_T" "$output_prefix")" || exit 1

echo "[mock-cluster shim] RFdiffusion CLI received — routing to the REAL built-in"
echo "[mock-cluster shim] diffusion engine (Ramachandran/NeRF torsion diffusion, numpy):"
echo "[mock-cluster shim] engine: $ENGINE"
echo "[mock-cluster shim] payload: $payload"

exec python3 "$ENGINE" "$payload"
