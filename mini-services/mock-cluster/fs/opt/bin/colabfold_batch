#!/usr/bin/env bash
# [mock-cluster shim] colabfold_batch CLI → the REAL built-in fold engine.
# Flags per the app's grammar (--fasta <path> --recycles N --templates …)
# plus the classic positional form (colabfold_batch IN [OUTDIR]) are routed
# to /home/z/my-project/scripts/algorithms/fold_engine.py.
set -u
ENGINE="/home/z/my-project/scripts/algorithms/fold_engine.py"
HELPER="/home/z/my-project/mini-services/mock-cluster/shims/generic_payload.py"

fasta=""; recycles=""; use_msa="true"; seed=""; outdir=""
positional=()
while [ $# -gt 0 ]; do
  case "$1" in
    --fasta|--fasta-path|-i)   fasta="$2"; shift 2 ;;
    --recycles|--num-recycles) recycles="$2"; shift 2 ;;
    --num-predictions|--model-type|--templates|--amber|--msa-mode)
      # value-taking / boolean colabfold flags: swallow token (+value when present)
      case "$2" in
        -*) shift ;;
        *)  shift 2 ;;
      esac
      ;;
    --seed)                    seed="$2"; shift 2 ;;
    --*)                       shift ;;   # unknown flags swallowed
    *)                         positional+=("$1"); shift ;;
  esac
done
# classic positional form: first = input, last = output dir
if [ "${#positional[@]}" -gt 0 ]; then
  [ -z "$fasta" ] && fasta="${positional[0]}"
  [ "${#positional[@]}" -gt 1 ] && outdir="${positional[${#positional[@]}-1]}"
fi
workdir="${outdir:-$(pwd)}"
[ -n "$outdir" ] && mkdir -p "$outdir" 2>/dev/null

payload="$(python3 "$HELPER" colabfold "$workdir" \
  fasta_path="$fasta" num_recycles="$recycles" use_msa="$use_msa" seed="$seed")" || exit 1

echo "[mock-cluster shim] colabfold_batch CLI received — routing to the REAL built-in"
echo "[mock-cluster shim] fold engine (Chou-Fasman + recycle consensus, numpy):"
echo "[mock-cluster shim] engine: $ENGINE"
echo "[mock-cluster shim] payload: $payload"

exec python3 "$ENGINE" "$payload"
