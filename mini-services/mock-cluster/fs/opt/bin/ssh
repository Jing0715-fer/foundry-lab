#!/usr/bin/env bash
# [mock-cluster shim] ssh — route to the test cluster's compute nodes.
#
# The tutorial's stage-2 step (`ssh gpu05 …`, after `salloc` on the login
# node) lands here. Known compute-node names (gpuNN / computeNN / cN /
# nodeNN) "log in": ssh starts at $HOME, then the remaining argv is joined
# and executed via `bash -c`, and its exit code is forwarded. Any other
# host is unreachable — there is no real network, so do NOT fall through to
# a real ssh binary (there is none worth using from this harness anyway):
#   ssh: connect to host <host>: No route to host   (exit 255)
set -u

if [ $# -lt 1 ]; then
  echo "ssh: missing host operand" >&2
  exit 255
fi

host="$1"
shift

case "$host" in
  gpu[0-9]|gpu[0-9][0-9]|compute[0-9]*|c[0-9]*|node[0-9]*)
    # ssh sessions start in the user's home directory
    if [ -n "${HOME:-}" ]; then
      cd "$HOME" || exit 255
    fi
    # Let tools on the "node" report which node they run on.
    export FOUNDRY_MOCK_HOST="$host"
    if [ $# -eq 0 ]; then
      # bare `ssh gpu05` → an interactive login shell on the node
      exec bash -l
    fi
    # Real ssh semantics: the remaining argv words are joined with spaces
    # and executed by the REMOTE shell, which parses the string afresh. So
    #   ssh gpu05 "nvidia-smi --query-gpu=… --format=csv,noheader"
    # lands as one shell line on the node — a plain "$*" join is exactly
    # right (and matches what the app's generated commands rely on).
    exec bash -c "$*"
    ;;
  *)
    echo "ssh: connect to host $host: No route to host" >&2
    exit 255
    ;;
esac
