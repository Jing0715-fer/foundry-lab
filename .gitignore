# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

# …but the API route dir is literally named "test" (probe endpoint)
!src/app/api/cluster/connections/\[id\]/test/

server.log
# Skills directory
/skills/
# Foundry Lab — run artifacts + external tool installs (regenerated at runtime)
/outputs/
/external-tools/
dev.log

# cluster connection secrets + run-state (never commit)
/data/

# python bytecode
__pycache__/
*.pyc

# cluster run-state / secrets
data/cluster-*.json

# transient tool outputs
tool-results/

# F6 commit hygiene: the LIVE demo database is runtime state (every run churns
# it). db/demo-baseline.db stays tracked as the source of truth — fresh clones
# materialize the live DB via `bun run demo:reset` (see README quick start).
db/custom.db
